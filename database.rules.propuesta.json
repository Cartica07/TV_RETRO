{
  "rules": {
    ".read": false,
    ".write": false,

    "administradores": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "dispositivos": {
      "$id": {
        ".read": "auth != null && (data.child('dueno').val() === auth.uid || auth.token.dispositivo === $id)",

        "dueno": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && root.child('emparejamiento').child(newData.parent().child('codigoUsado').val()).child('id').val() === $id && root.child('emparejamiento').child(newData.parent().child('codigoUsado').val()).child('creado').val() > now - 600000) || (data.val() === auth.uid && !newData.exists()))",
          ".validate": "newData.isString() && newData.val().length <= 128"
        },

        "codigoUsado": {
          ".write": "auth != null && ((!data.parent().child('dueno').exists() && newData.parent().child('dueno').val() === auth.uid) || data.parent().child('dueno').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{6}$/)"
        },

        "oled_remota": {
          "lastSeen": {
            ".write": "auth != null && auth.token.dispositivo === $id",
            ".validate": "newData.isNumber()"
          },
          "version": {
            ".write": "auth != null && root.child('dispositivos').child($id).child('dueno').val() === auth.uid",
            ".validate": "newData.isNumber()"
          },
          "contadorVersion": {
            ".write": "auth != null && root.child('dispositivos').child($id).child('dueno').val() === auth.uid",
            ".validate": "newData.isNumber()"
          },
          "pantalla": {
            ".write": "auth != null && root.child('dispositivos').child($id).child('dueno').val() === auth.uid",
            ".validate": "newData.hasChildren(['tipo']) && newData.child('tipo').isString() && (newData.child('tipo').val() === 'texto' || newData.child('tipo').val() === 'imagen' || newData.child('tipo').val() === 'cancion' || newData.child('tipo').val() === 'animacion' || newData.child('tipo').val() === 'musical')",
            "texto": {
              ".validate": "newData.isString() && newData.val().length <= 5000"
            },
            "imagen": {
              "datos": {
                ".validate": "newData.isString() && newData.val().length <= 100000"
              }
            }
          },
          "archivo": {
            ".write": "auth != null && root.child('dispositivos').child($id).child('dueno').val() === auth.uid",
            "version": {
              ".validate": "newData.isNumber()"
            },
            "datos": {
              ".validate": "newData.isString() && newData.val().length <= 10000000"
            }
          }
        }
      }
    },

    "emparejamiento": {
      "$codigo": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('id').val() === auth.token.dispositivo) || (data.exists() && data.child('id').val() === auth.token.dispositivo))",
        ".validate": "$codigo.matches(/^[A-HJ-NP-Z2-9]{6}$/) && newData.hasChildren(['id', 'creado']) && newData.child('id').isString() && newData.child('id').val() === auth.token.dispositivo && newData.child('creado').isNumber() && newData.child('creado').val() === now",
        "id": {},
        "creado": {},
        "$otro": {
          ".validate": false
        }
      }
    },

    "usuarios": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",

        "dispositivos": {
          "$id": {
            ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('dispositivos').child($id).child('dueno').val() === $uid)",
            ".validate": "newData.val() === true"
          }
        },

        "imagenes": {
          "$clave": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['datos', 'ancho', 'alto']) && newData.child('datos').isString() && newData.child('datos').val().length <= 100000"
          }
        },

        "animaciones": {
          "$clave": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['ancho', 'alto', 'cuadros'])"
          }
        }
      }
    },

    "musicales": {
      "indice": {
        ".read": "auth != null",
        "$clave": {
          ".write": "auth != null && root.child('administradores').child(auth.uid).val() === true"
        }
      },
      "datos": {
        "$clave": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('administradores').child(auth.uid).val() === true",
          ".validate": "newData.isString()"
        }
      }
    }
  }
}
